{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:issue-orchestration:profile-capability-matrix:v3",
    "title": "issue-orchestration.profile-capability-matrix.v3",
    "type": "object",
    "required": [
        "schema",
        "policyVersion",
        "modelPoolPolicyVersion",
        "evidenceAuthority",
        "evidenceFixture",
        "evidenceDigest",
        "modelSelfReportAccepted",
        "profiles"
    ],
    "properties": {
        "schema": {
            "const": "issue-orchestration.profile-capability-matrix.v3"
        },
        "policyVersion": {
            "const": "execution-capability-routing.v3"
        },
        "modelPoolPolicyVersion": {
            "const": "stage-model-pool.v3"
        },
        "evidenceAuthority": {
            "const": "recomputed-codex-v2-runtime-observations"
        },
        "evidenceFixture": {
            "const": "profile-capability-observations.json"
        },
        "evidenceDigest": {
            "$ref": "#/$defs/digest"
        },
        "modelSelfReportAccepted": {
            "const": false
        },
        "profiles": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "object",
                "required": [
                    "planningDepth",
                    "toolChainPersistence",
                    "contextRetentionClass",
                    "checkpointReliability",
                    "runtimeProbeCapability",
                    "crossModuleReasoningClass",
                    "allowedContinuationModes",
                    "evidenceDigest"
                ],
                "properties": {
                    "planningDepth": {"$ref": "#/$defs/level"},
                    "toolChainPersistence": {"$ref": "#/$defs/level"},
                    "contextRetentionClass": {"$ref": "#/$defs/level"},
                    "checkpointReliability": {"$ref": "#/$defs/level"},
                    "runtimeProbeCapability": {"$ref": "#/$defs/level"},
                    "crossModuleReasoningClass": {"$ref": "#/$defs/level"},
                    "allowedContinuationModes": {
                        "type": "array",
                        "items": {
                            "enum": [
                                "none",
                                "checkpoint-resume",
                                "durable-continuation"
                            ]
                        },
                        "minItems": 1,
                        "uniqueItems": true
                    },
                    "evidenceDigest": {"$ref": "#/$defs/digest"}
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
        }
    }
}
