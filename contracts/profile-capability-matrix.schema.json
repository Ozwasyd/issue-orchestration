{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:issue-orchestration:profile-capability-matrix:v2",
    "title": "issue-orchestration.profile-capability-matrix.v2",
    "type": "object",
    "required": [
        "schema",
        "policyVersion",
        "modelPoolPolicyVersion",
        "evidenceAuthority",
        "evidenceFixture",
        "evidenceDigest",
        "modelSelfReportAccepted",
        "profiles"
    ],
    "properties": {
        "schema": {
            "const": "issue-orchestration.profile-capability-matrix.v2"
        },
        "policyVersion": {
            "const": "execution-capability-routing.v2"
        },
        "modelPoolPolicyVersion": {
            "const": "stage-model-pool.v3"
        },
        "evidenceAuthority": {
            "const": "recomputed-codex-v2-runtime-observations"
        },
        "evidenceFixture": {
            "const": "profile-capability-observations.json"
        },
        "evidenceDigest": {
            "$ref": "#/$defs/digest"
        },
        "modelSelfReportAccepted": {
            "const": false
        },
        "profiles": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "object",
                "required": [
                    "planningDepth",
                    "toolChainPersistence",
                    "contextRetentionClass",
                    "checkpointReliability",
                    "runtimeProbeCapability",
                    "crossModuleReasoningClass",
                    "supportedSandboxes",
                    "allowedContinuationModes",
                    "evidenceDigest"
                ]
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        }
    }
}
