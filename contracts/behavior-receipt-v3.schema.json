{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:issue-orchestration:behavior-receipt:v3",
  "title": "issue-orchestration.behavior-receipt.v3",
  "type": "object",
  "required": [
    "schema", "status", "candidate", "candidateDigest",
    "blockerReceiptDigest", "impactPlanDigest", "verifierRolloutId",
    "freshContext", "executionClass", "mutationContract",
    "runtimeExecutionBindingDigest", "mutationPostconditionReceiptDigest",
    "commandEvidence", "reusableEvidence",
    "receiptDigest"
  ],
  "properties": {
    "schema": {"const": "issue-orchestration.behavior-receipt.v3"},
    "status": {"const": "behavior-green"},
    "candidate": {"type": "object"},
    "candidateDigest": {"$ref": "#/$defs/digest"},
    "blockerReceiptDigest": {"$ref": "#/$defs/digest"},
    "impactPlanDigest": {"$ref": "#/$defs/digest"},
    "verifierRolloutId": {"type": "string"},
    "freshContext": {"const": true},
    "executionClass": {"const": "observe-only"},
    "mutationContract": {"const": "no-protected-mutation"},
    "runtimeExecutionBindingDigest": {"$ref": "#/$defs/digest"},
    "mutationPostconditionReceiptDigest": {"$ref": "#/$defs/digest"},
    "commandEvidence": {"type": "array", "minItems": 1},
    "reusableEvidence": {"type": "array"},
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false,
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
