{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:issue-orchestration:root-recovery-launch-receipt:v1",
  "title": "issue-orchestration.root-recovery-launch-receipt.v1",
  "type": "object",
  "required": [
    "schema",
    "producerAuthority",
    "policyDigest",
    "status",
    "runId",
    "takeoverAuthorizationDigest",
    "fencingReceiptDigest",
    "handoffDigest",
    "expectedNewInvocationId",
    "expectedInvocationClass",
    "requestedStage",
    "requestedProfile",
    "requestedModel",
    "requestedEffort",
    "requestedMultiAgentBackend",
    "requestedTrustMode",
    "requestedPermissionProfile",
    "requestedApprovalPolicy",
    "newRootAuthorityEpoch",
    "attemptOrdinal",
    "launchedAt",
    "receiptDigest"
  ],
  "properties": {
    "schema": {
      "const": "issue-orchestration.root-recovery-launch-receipt.v1"
    },
    "producerAuthority": {
      "const": "deterministic-external-root-supervisor"
    },
    "policyDigest": {"$ref": "#/$defs/digest"},
    "status": {"const": "launch-authorized"},
    "runId": {"type": "string", "minLength": 1},
    "takeoverAuthorizationDigest": {"$ref": "#/$defs/digest"},
    "fencingReceiptDigest": {"$ref": "#/$defs/digest"},
    "handoffDigest": {"$ref": "#/$defs/digest"},
    "expectedNewInvocationId": {"type": "string", "minLength": 1},
    "expectedInvocationClass": {"const": "parent-invocation"},
    "requestedStage": {"const": "recovery-takeover"},
    "requestedProfile": {"const": "terra-medium"},
    "requestedModel": {"const": "gpt-5.6-terra"},
    "requestedEffort": {"const": "medium"},
    "requestedMultiAgentBackend": {"const": "v2"},
    "requestedTrustMode": {"const": "trusted-owner-repositories"},
    "requestedPermissionProfile": {"const": "danger-full-access"},
    "requestedApprovalPolicy": {"const": "never"},
    "newRootAuthorityEpoch": {"type": "string", "minLength": 1},
    "attemptOrdinal": {"const": 1},
    "launchedAt": {"type": "string", "format": "date-time"},
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
