{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:issue-orchestration:root-takeover-eligibility-receipt:v1",
  "title": "issue-orchestration.root-takeover-eligibility-receipt.v1",
  "type": "object",
  "required": [
    "schema",
    "producerAuthority",
    "policyDigest",
    "status",
    "runId",
    "oldRootInvocationId",
    "oldRootSessionId",
    "reasonCode",
    "directEvidenceDigest",
    "failureProjectionDigest",
    "advisorDisposition",
    "advisorEvidenceDigest",
    "lowerCostRecoveryExhausted",
    "issuedAt",
    "receiptDigest"
  ],
  "properties": {
    "schema": {
      "const": "issue-orchestration.root-takeover-eligibility-receipt.v1"
    },
    "producerAuthority": {"const": "machine-takeover-policy"},
    "policyDigest": {"$ref": "#/$defs/digest"},
    "status": {"const": "eligible"},
    "runId": {"type": "string", "minLength": 1},
    "oldRootInvocationId": {"type": "string", "minLength": 1},
    "oldRootSessionId": {"type": "string", "minLength": 1},
    "reasonCode": {"type": "string", "minLength": 1},
    "directEvidenceDigest": {"$ref": "#/$defs/digest"},
    "failureProjectionDigest": {"$ref": "#/$defs/digest"},
    "advisorDisposition": {"type": "string", "minLength": 1},
    "advisorEvidenceDigest": {"$ref": "#/$defs/nullableDigest"},
    "lowerCostRecoveryExhausted": {"const": true},
    "issuedAt": {"type": "string", "format": "date-time"},
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableDigest": {
      "oneOf": [
        {"$ref": "#/$defs/digest"},
        {"type": "null"}
      ]
    }
  }
}
