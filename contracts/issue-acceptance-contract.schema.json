{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:issue-orchestration:issue-acceptance-contract:v1",
  "title": "issue-orchestration.issue-acceptance-contract.v1",
  "type": "object",
  "required": [
    "schema", "status", "repository", "issueNumber",
    "selectorReceiptDigest", "remoteSnapshotDigest", "inventoryDigest",
    "executableAcceptanceIds", "constraintIds", "nonGoalIds",
    "sourceBindings", "contractDigest"
  ],
  "properties": {
    "schema": {"const": "issue-orchestration.issue-acceptance-contract.v1"},
    "status": {"const": "frozen"},
    "repository": {"type": "string"},
    "issueNumber": {"type": "integer", "minimum": 1},
    "selectorReceiptDigest": {"$ref": "#/$defs/digest"},
    "remoteSnapshotDigest": {"$ref": "#/$defs/digest"},
    "inventoryDigest": {"$ref": "#/$defs/digest"},
    "executableAcceptanceIds": {"$ref": "#/$defs/ids"},
    "constraintIds": {"$ref": "#/$defs/ids"},
    "nonGoalIds": {"$ref": "#/$defs/ids"},
    "sourceBindings": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "contractDigest": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
