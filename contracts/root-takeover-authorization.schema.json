{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:issue-orchestration:root-takeover-authorization:v1",
  "title": "issue-orchestration.root-takeover-authorization.v1",
  "type": "object",
  "required": [
    "schema",
    "producerAuthority",
    "policyDigest",
    "status",
    "runId",
    "oldRootInvocationId",
    "oldRootSessionId",
    "oldRootAuthorityEpoch",
    "oldRootControlLeaseDigest",
    "oldRootStartupAttestationDigest",
    "expectedNewRootPhase",
    "expectedNewRootProfile",
    "expectedNewInvocationClass",
    "expectedNewInvocationId",
    "newRootAuthorityEpoch",
    "reasonCode",
    "directEvidenceDigest",
    "eligibilityReceiptDigest",
    "advisorRequestDigest",
    "advisorProposalDigest",
    "recoveryPlanDigest",
    "deterministicRecoveryDisposition",
    "packageDigest",
    "policySetDigest",
    "stateRootDigest",
    "checkpointIdentityDigest",
    "repositoryStateDigest",
    "baseSha",
    "deliveryEpoch",
    "remoteSnapshotDigest",
    "activeInventoryDigest",
    "requiredDispositionDigest",
    "fencingRequirementsDigest",
    "attemptOrdinal",
    "issuedAt",
    "expiresAt",
    "authorizationDigest"
  ],
  "properties": {
    "schema": {
      "const": "issue-orchestration.root-takeover-authorization.v1"
    },
    "producerAuthority": {"const": "machine-takeover-policy"},
    "policyDigest": {"$ref": "#/$defs/digest"},
    "status": {"const": "authorized"},
    "runId": {"type": "string", "minLength": 1},
    "oldRootInvocationId": {"type": "string", "minLength": 1},
    "oldRootSessionId": {"type": "string", "minLength": 1},
    "oldRootAuthorityEpoch": {"type": "string", "minLength": 1},
    "oldRootControlLeaseDigest": {"$ref": "#/$defs/digest"},
    "oldRootStartupAttestationDigest": {"$ref": "#/$defs/digest"},
    "expectedNewRootPhase": {"const": "recovery-takeover"},
    "expectedNewRootProfile": {"const": "terra-medium"},
    "expectedNewInvocationClass": {"const": "parent-invocation"},
    "expectedNewInvocationId": {"type": "string", "minLength": 1},
    "newRootAuthorityEpoch": {"type": "string", "minLength": 1},
    "reasonCode": {"type": "string", "minLength": 1},
    "directEvidenceDigest": {"$ref": "#/$defs/digest"},
    "eligibilityReceiptDigest": {"$ref": "#/$defs/digest"},
    "advisorRequestDigest": {"$ref": "#/$defs/nullableDigest"},
    "advisorProposalDigest": {"$ref": "#/$defs/nullableDigest"},
    "recoveryPlanDigest": {"$ref": "#/$defs/nullableDigest"},
    "deterministicRecoveryDisposition": {
      "type": "string",
      "minLength": 1
    },
    "packageDigest": {"$ref": "#/$defs/digest"},
    "policySetDigest": {"$ref": "#/$defs/digest"},
    "stateRootDigest": {"$ref": "#/$defs/digest"},
    "checkpointIdentityDigest": {"$ref": "#/$defs/digest"},
    "repositoryStateDigest": {"$ref": "#/$defs/digest"},
    "baseSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "deliveryEpoch": {"type": "string", "minLength": 1},
    "remoteSnapshotDigest": {"$ref": "#/$defs/digest"},
    "activeInventoryDigest": {"$ref": "#/$defs/digest"},
    "requiredDispositionDigest": {"$ref": "#/$defs/digest"},
    "fencingRequirementsDigest": {"$ref": "#/$defs/digest"},
    "attemptOrdinal": {"const": 1},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "authorizationDigest": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableDigest": {
      "oneOf": [
        {"$ref": "#/$defs/digest"},
        {"type": "null"}
      ]
    }
  }
}
