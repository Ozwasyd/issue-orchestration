{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:issue-orchestration:issue-requirement-inventory:v1",
  "title": "issue-orchestration.issue-requirement-inventory.v1",
  "type": "object",
  "required": [
    "schema", "status", "repository", "issueNumber",
    "selectorReceiptDigest", "remoteSnapshotDigest", "proposalDigest",
    "requirements", "sourceCoverageDigest", "inventoryDigest"
  ],
  "properties": {
    "schema": {"const": "issue-orchestration.issue-requirement-inventory.v1"},
    "status": {"const": "verified"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "issueNumber": {"type": "integer", "minimum": 1},
    "selectorReceiptDigest": {"$ref": "#/$defs/digest"},
    "remoteSnapshotDigest": {"$ref": "#/$defs/digest"},
    "proposalDigest": {"$ref": "#/$defs/digest"},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "sourceCoverageDigest": {"$ref": "#/$defs/digest"},
    "inventoryDigest": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false,
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
