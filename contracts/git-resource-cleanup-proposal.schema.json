{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:issue-orchestration:git-resource-cleanup-proposal:v1",
  "title": "issue-orchestration.git-resource-cleanup-proposal.v1",
  "type": "object",
  "required": [
    "schema",
    "producerAuthority",
    "lifecycleId",
    "runId",
    "attemptId",
    "action",
    "reasonCodes",
    "executionAuthority",
    "proposedAt",
    "proposalDigest"
  ],
  "properties": {
    "schema": {"const": "issue-orchestration.git-resource-cleanup-proposal.v1"},
    "producerAuthority": {"const": "llm-advisor"},
    "lifecycleId": {"$ref": "#/$defs/digest"},
    "runId": {"type": "string", "minLength": 1},
    "attemptId": {"type": "string", "minLength": 1},
    "action": {
      "enum": [
        "refresh-worktree-inventory",
        "recompute-candidate-landing-map",
        "terminate-owned-process",
        "quarantine-unmapped-work",
        "retry-git-aware-remove",
        "operator-required"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "executionAuthority": {"const": false},
    "proposedAt": {"type": "string", "format": "date-time"},
    "proposalDigest": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
