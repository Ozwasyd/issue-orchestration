{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:issue-orchestration:worktree-force-removal-authorization:v1",
  "title": "issue-orchestration.worktree-force-removal-authorization.v1",
  "type": "object",
  "required": [
    "schema",
    "producerAuthority",
    "policyDigest",
    "lifecycleId",
    "runId",
    "rootAuthorityEpoch",
    "attemptId",
    "repositoryId",
    "worktreeResourceId",
    "branchResourceId",
    "worktreePath",
    "worktreeFilesystemIdentity",
    "branchRef",
    "baseSha",
    "candidateSha",
    "deliveryEpoch",
    "leaseId",
    "inventoryDigest",
    "dispositionReceiptDigest",
    "processObservationDigest",
    "disposition",
    "quarantineReceiptDigest",
    "ordinaryFailureStatus",
    "ordinaryFailureDigest",
    "reason",
    "authorizedAt",
    "authorizationDigest"
  ],
  "properties": {
    "schema": {"const": "issue-orchestration.worktree-force-removal-authorization.v1"},
    "producerAuthority": {"const": "machine-git-resource-cleaner"},
    "policyDigest": {"$ref": "#/$defs/digest"},
    "lifecycleId": {"$ref": "#/$defs/digest"},
    "runId": {"type": "string", "minLength": 1},
    "rootAuthorityEpoch": {"type": "string", "minLength": 1},
    "attemptId": {"type": "string", "minLength": 1},
    "repositoryId": {"type": "string", "minLength": 1},
    "worktreeResourceId": {"type": "string", "minLength": 1},
    "branchResourceId": {"type": "string", "minLength": 1},
    "worktreePath": {"type": "string", "minLength": 1},
    "worktreeFilesystemIdentity": {"type": "object"},
    "branchRef": {"type": "string", "pattern": "^refs/heads/"},
    "baseSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "candidateSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "deliveryEpoch": {"type": "string", "minLength": 1},
    "leaseId": {"type": "string", "minLength": 1},
    "inventoryDigest": {"$ref": "#/$defs/digest"},
    "dispositionReceiptDigest": {"$ref": "#/$defs/digest"},
    "processObservationDigest": {"$ref": "#/$defs/digest"},
    "disposition": {"const": "quarantined"},
    "quarantineReceiptDigest": {"$ref": "#/$defs/digest"},
    "ordinaryFailureStatus": {"type": "integer", "minimum": 1},
    "ordinaryFailureDigest": {"$ref": "#/$defs/digest"},
    "reason": {"type": "string", "minLength": 1},
    "authorizedAt": {"type": "string", "format": "date-time"},
    "authorizationDigest": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
