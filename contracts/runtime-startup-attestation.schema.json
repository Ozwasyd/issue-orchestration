{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:issue-orchestration:runtime-startup-attestation:v1",
  "title": "issue-orchestration.runtime-startup-attestation.v1",
  "type": "object",
  "required": [
    "schema",
    "policyVersion",
    "status",
    "reasonCodes",
    "orchestrationEnabled",
    "runtimeInvocationId",
    "runtimeSessionId",
    "runtimeId",
    "runtimeVersion",
    "rootPhase",
    "selectedProfile",
    "effectiveProfile",
    "effectiveModel",
    "effectiveEffort",
    "effectiveMultiAgentBackend",
    "trustMode",
    "effectiveSandbox",
    "effectivePermissionProfile",
    "effectiveApprovalPolicy",
    "permissionInheritance",
    "permissionGuarantee",
    "capacityDigest",
    "rootRouteDigest",
    "rootAuthorityEpoch",
    "observationDigest",
    "packageDigest",
    "manifestDigest",
    "policyDigests",
    "recoveryAuthorizationDigest",
    "takeoverHandoffDigest",
    "oldRootFencingReceiptDigest",
    "attestedAt",
    "attestationDigest"
  ],
  "properties": {
    "schema": {
      "const": "issue-orchestration.runtime-startup-attestation.v1"
    },
    "policyVersion": {"const": "runtime-startup-attestation.v1"},
    "status": {"enum": ["verified", "rejected"]},
    "reasonCodes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "orchestrationEnabled": {"type": "boolean"},
    "runtimeInvocationId": {"type": "string", "minLength": 1},
    "runtimeSessionId": {"type": "string", "minLength": 1},
    "runtimeId": {"enum": ["codex", "claude-code", "grok-build"]},
    "runtimeVersion": {"type": "string", "minLength": 1},
    "rootPhase": {
      "enum": ["scheduling", "recovery-takeover"]
    },
    "selectedProfile": {"enum": ["terra-low", "terra-medium"]},
    "effectiveProfile": {"enum": ["terra-low", "terra-medium"]},
    "effectiveModel": {"type": "string", "minLength": 1},
    "effectiveEffort": {"type": "string", "minLength": 1},
    "effectiveMultiAgentBackend": {"type": "string", "minLength": 1},
    "trustMode": {"const": "trusted-owner-repositories"},
    "effectiveSandbox": {"type": "string", "minLength": 1},
    "effectivePermissionProfile": {"type": "string", "minLength": 1},
    "effectiveApprovalPolicy": {"type": "string", "minLength": 1},
    "permissionInheritance": {"type": "string", "minLength": 1},
    "permissionGuarantee": {"type": "string", "minLength": 1},
    "capacityDigest": {"$ref": "#/$defs/digest"},
    "rootRouteDigest": {"$ref": "#/$defs/digest"},
    "rootAuthorityEpoch": {"type": "string", "minLength": 1},
    "observationDigest": {"$ref": "#/$defs/digest"},
    "packageDigest": {"$ref": "#/$defs/digest"},
    "manifestDigest": {"$ref": "#/$defs/digest"},
    "policyDigests": {
      "type": "object",
      "required": [
        "modelPool",
        "routing",
        "executionRouting",
        "stagePermissions",
        "runtimeTrust",
        "runtimeStartup",
        "runtimeExecutionBinding",
        "stageMutationGuard",
        "remoteMutation",
        "rootTakeover",
        "controlPlaneAdvisor",
        "terminal"
      ],
      "properties": {
        "modelPool": {"$ref": "#/$defs/digest"},
        "routing": {"$ref": "#/$defs/digest"},
        "executionRouting": {"$ref": "#/$defs/digest"},
        "stagePermissions": {"$ref": "#/$defs/digest"},
        "runtimeTrust": {"$ref": "#/$defs/digest"},
        "runtimeStartup": {"$ref": "#/$defs/digest"},
        "runtimeExecutionBinding": {"$ref": "#/$defs/digest"},
        "stageMutationGuard": {"$ref": "#/$defs/digest"},
        "remoteMutation": {"$ref": "#/$defs/digest"},
        "rootTakeover": {"$ref": "#/$defs/digest"},
        "controlPlaneAdvisor": {"$ref": "#/$defs/digest"},
        "terminal": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "recoveryAuthorizationDigest": {
      "anyOf": [
        {"$ref": "#/$defs/digest"},
        {"type": "null"}
      ]
    },
    "takeoverHandoffDigest": {
      "anyOf": [
        {"$ref": "#/$defs/digest"},
        {"type": "null"}
      ]
    },
    "oldRootFencingReceiptDigest": {
      "anyOf": [
        {"$ref": "#/$defs/digest"},
        {"type": "null"}
      ]
    },
    "attestedAt": {"type": "string", "format": "date-time"},
    "attestationDigest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "verified"}}
      },
      "then": {
        "properties": {
          "reasonCodes": {"type": "array", "maxItems": 0},
          "orchestrationEnabled": {"type": "boolean", "const": true}
        }
      },
      "else": {
        "properties": {
          "reasonCodes": {"type": "array", "minItems": 1},
          "orchestrationEnabled": {"type": "boolean", "const": false}
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
