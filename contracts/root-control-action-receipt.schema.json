{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:issue-orchestration:root-control-action-receipt:v1",
  "title": "issue-orchestration.root-control-action-receipt.v1",
  "type": "object",
  "required": [
    "schema", "status", "rootProfile", "startupAttestationDigest",
    "runtimeInvocationId", "runtimeSessionId", "rootAuthorityEpoch",
    "runtimeTrustMode",
    "runtimeTrustBindingDigest", "runtimePermissionEvidenceDigest",
    "effectivePermissionProfile", "permissionInheritance",
    "machineEnforcedRoleIsolation", "mutationPostconditionRequired",
    "projectionDigest", "action", "actionInputDigest",
    "semanticWorkPerformedByRoot", "receiptDigest"
  ],
  "properties": {
    "schema": {"const": "issue-orchestration.root-control-action-receipt.v1"},
    "status": {"const": "authorized"},
    "rootProfile": {"enum": ["terra-low", "terra-medium"]},
    "startupAttestationDigest": {"$ref": "#/$defs/digest"},
    "runtimeInvocationId": {"type": "string", "minLength": 1},
    "runtimeSessionId": {"type": "string", "minLength": 1},
    "rootAuthorityEpoch": {"type": "string", "minLength": 1},
    "runtimeTrustMode": {"const": "trusted-owner-repositories"},
    "runtimeTrustBindingDigest": {"$ref": "#/$defs/digest"},
    "runtimePermissionEvidenceDigest": {"$ref": "#/$defs/digest"},
    "effectivePermissionProfile": {"const": "danger-full-access"},
    "permissionInheritance": {"const": "inherited-parent-profile"},
    "machineEnforcedRoleIsolation": {"const": false},
    "mutationPostconditionRequired": {"const": true},
    "projectionDigest": {"$ref": "#/$defs/digest"},
    "action": {"type": "string"},
    "actionInputDigest": {"$ref": "#/$defs/digest"},
    "semanticWorkPerformedByRoot": {"const": false},
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false,
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
