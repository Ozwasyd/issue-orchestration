{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:issue-orchestration:root-control-action-receipt:v1",
  "title": "issue-orchestration.root-control-action-receipt.v1",
  "type": "object",
  "required": [
    "schema", "status", "rootProfile", "projectionDigest", "action",
    "actionInputDigest", "semanticWorkPerformedByRoot", "receiptDigest"
  ],
  "properties": {
    "schema": {"const": "issue-orchestration.root-control-action-receipt.v1"},
    "status": {"const": "authorized"},
    "rootProfile": {"enum": ["terra-low", "terra-medium"]},
    "projectionDigest": {"$ref": "#/$defs/digest"},
    "action": {"type": "string"},
    "actionInputDigest": {"$ref": "#/$defs/digest"},
    "semanticWorkPerformedByRoot": {"const": false},
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false,
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
