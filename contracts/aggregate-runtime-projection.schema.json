{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "issue-orchestration.aggregate-runtime-projection.schema.json",
  "title": "Issue orchestration aggregate runtime projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "runId", "controlProjectionDigest", "nodeIndexDigest",
    "nodes", "acceptanceGroups", "slots", "deliveryFreezes",
    "deliveryEffects", "cleanupFinalizations", "terminal",
    "aggregateProjectionDigest"
  ],
  "properties": {
    "schema": {"const": "issue-orchestration.aggregate-runtime-projection.v1"},
    "runId": {"type": "string", "minLength": 1},
    "controlProjectionDigest": {"$ref": "#/$defs/digest"},
    "nodeIndexDigest": {"$ref": "#/$defs/digest"},
    "nodes": {"type": "object"},
    "acceptanceGroups": {"type": "object"},
    "slots": {"type": "object"},
    "deliveryFreezes": {"type": "object"},
    "deliveryEffects": {"type": "object"},
    "cleanupFinalizations": {"type": "object"},
    "terminal": {"type": ["object", "null"]},
    "aggregateProjectionDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
