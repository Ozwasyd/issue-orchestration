{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:issue-orchestration:execution-route-decision:v2",
  "title": "issue-orchestration.execution-route-decision.v2",
  "type": "object",
  "required": [
    "schema",
    "policyVersion",
    "modelPoolPolicyVersion",
    "routingAuthority",
    "sliceId",
    "sliceDigest",
    "stageRole",
    "stagePhase",
    "classificationDigest",
    "capabilityDigest",
    "routeCellId",
    "routeCellDigest",
    "selectingPredicates",
    "selectingPredicatesDigest",
    "canonicalPolicyDigest",
    "requiredProfile",
    "capabilityValidationResult",
    "reviewedAssumptionDigest",
    "allowedProfiles",
    "selectedProfile",
    "selectedProfileReason",
    "requestedModel",
    "requestedEffort",
    "multiAgentBackend",
    "executionClass",
    "runtimeExecutionBindingDigest",
    "runtimeExecutionBindingStatus",
    "runtimeVerificationStatus",
    "runtimeInvocationId",
    "runtimeIdentityDigest",
    "availabilityHandling",
    "availabilityBindingDigest",
    "availabilityFallbackReason",
    "previousRouteDecisionDigest",
    "previousFailureReceiptDigest",
    "retryAuthorizationDigest",
    "previousCandidateReceiptDigest",
    "routeDecisionDigest"
  ],
  "properties": {
    "schema": {
      "const": "issue-orchestration.execution-route-decision.v2"
    },
    "policyVersion": {
      "const": "execution-capability-routing.v5"
    },
    "modelPoolPolicyVersion": {
      "const": "stage-model-pool.v4"
    },
    "routingAuthority": {
      "const": "canonical-route-cell-compiler"
    },
    "sliceId": {
      "type": "string",
      "minLength": 1
    },
    "sliceDigest": {
      "$ref": "#/$defs/digest"
    },
    "stageRole": {
      "type": "string",
      "minLength": 1
    },
    "stagePhase": {
      "type": "string",
      "minLength": 1
    },
    "classificationDigest": {
      "$ref": "#/$defs/digest"
    },
    "capabilityDigest": {
      "$ref": "#/$defs/digest"
    },
    "routeCellId": {
      "type": "string",
      "minLength": 1
    },
    "routeCellDigest": {
      "$ref": "#/$defs/digest"
    },
    "selectingPredicates": {
      "type": "object",
      "minProperties": 1
    },
    "selectingPredicatesDigest": {
      "$ref": "#/$defs/digest"
    },
    "canonicalPolicyDigest": {
      "$ref": "#/$defs/digest"
    },
    "requiredProfile": {
      "type": "string",
      "minLength": 1
    },
    "capabilityValidationResult": {
      "const": "accepted"
    },
    "reviewedAssumptionDigest": {
      "$ref": "#/$defs/digest"
    },
    "allowedProfiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "selectedProfile": {
      "type": "string",
      "minLength": 1
    },
    "selectedProfileReason": {
      "type": "string",
      "minLength": 1
    },
    "requestedModel": {
      "type": "string",
      "minLength": 1
    },
    "requestedEffort": {
      "type": "string",
      "minLength": 1
    },
    "multiAgentBackend": {
      "const": "v2"
    },
    "executionClass": {
      "enum": [
        "root-control",
        "observe-only",
        "leased-writer"
      ]
    },
    "runtimeExecutionBindingDigest": {
      "$ref": "#/$defs/nullableDigest"
    },
    "runtimeExecutionBindingStatus": {
      "enum": [
        "pending-observation",
        "verified"
      ]
    },
    "runtimeVerificationStatus": {
      "enum": [
        "pending-observation",
        "verified"
      ]
    },
    "runtimeInvocationId": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "runtimeIdentityDigest": {
      "$ref": "#/$defs/nullableDigest"
    },
    "availabilityHandling": {
      "const": "not-required"
    },
    "availabilityBindingDigest": {
      "const": null
    },
    "availabilityFallbackReason": {
      "const": null
    },
    "previousRouteDecisionDigest": {
      "$ref": "#/$defs/nullableDigest"
    },
    "previousFailureReceiptDigest": {
      "$ref": "#/$defs/nullableDigest"
    },
    "retryAuthorizationDigest": {
      "$ref": "#/$defs/nullableDigest"
    },
    "previousCandidateReceiptDigest": {
      "$ref": "#/$defs/nullableDigest"
    },
    "routeDecisionDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullableDigest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
