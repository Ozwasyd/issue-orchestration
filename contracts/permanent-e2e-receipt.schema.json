{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:issue-orchestration:permanent-e2e-receipt:v2",
  "title": "issue-orchestration.permanent-e2e-receipt.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "productionReady",
    "mode",
    "packageDigest",
    "policyDigest",
    "sourceCommit",
    "runFamily",
    "candidateDigest",
    "evidenceRefs",
    "fiveCwdDiscoveryVerified",
    "testContractLivenessVerified",
    "outputMissingRecoveryVerified",
    "onlineWatchdogVerified",
    "verifierRevalidationVerified",
    "realGitLandingVerified",
    "acceptanceGroupAtomicityVerified",
    "uiDualSkillVerified",
    "humanGateVerified",
    "rootProfileVerified",
    "rootMechanicalControlVerified",
    "mutationControlsKilled",
    "mutationEvidenceDigest",
    "quiescenceViolations",
    "quiescenceObservationDigest",
    "temporaryBootstrapUsed",
    "temporarySchedulerUsed",
    "fallbackExecutorUsed",
    "repoLocalCopyUsed",
    "receiptDigest"
  ],
  "properties": {
    "schema": {
      "const": "issue-orchestration.permanent-e2e-receipt.v2"
    },
    "status": {
      "enum": ["production-verified", "fixture-verified"]
    },
    "productionReady": {
      "type": "boolean"
    },
    "mode": {
      "enum": ["live", "fixture"]
    },
    "packageDigest": {
      "$ref": "#/$defs/hash"
    },
    "policyDigest": {
      "$ref": "#/$defs/hash"
    },
    "sourceCommit": {
      "$ref": "#/$defs/sha"
    },
    "runFamily": {
      "type": "string",
      "minLength": 1
    },
    "candidateDigest": {
      "$ref": "#/$defs/hash"
    },
    "evidenceRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shared-package-discovery",
        "model-pool-consistency",
        "root-runtime-canary",
        "root-mechanical-control",
        "dag-startup-gate",
        "first-writer-cold-start",
        "scope-frontier-routing-consistency",
        "acceptance-slice-authority",
        "output-missing-retry",
        "writer-runtime-watchdog",
        "verifier-revalidation",
        "git-landing-delivery",
        "mutation-execution-summary",
        "live-quiescence",
        "no-temporary-scheduler-trace",
        "human-decision-gate",
        "acceptance-group-atomicity",
        "ui-dual-skill"
      ],
      "properties": {
        "shared-package-discovery": {"$ref": "#/$defs/hash"},
        "model-pool-consistency": {"$ref": "#/$defs/hash"},
        "root-runtime-canary": {"$ref": "#/$defs/hash"},
        "root-mechanical-control": {"$ref": "#/$defs/hash"},
        "dag-startup-gate": {"$ref": "#/$defs/hash"},
        "first-writer-cold-start": {"$ref": "#/$defs/hash"},
        "scope-frontier-routing-consistency": {"$ref": "#/$defs/hash"},
        "acceptance-slice-authority": {"$ref": "#/$defs/hash"},
        "output-missing-retry": {"$ref": "#/$defs/hash"},
        "writer-runtime-watchdog": {"$ref": "#/$defs/hash"},
        "verifier-revalidation": {"$ref": "#/$defs/hash"},
        "git-landing-delivery": {"$ref": "#/$defs/hash"},
        "mutation-execution-summary": {"$ref": "#/$defs/hash"},
        "live-quiescence": {"$ref": "#/$defs/hash"},
        "no-temporary-scheduler-trace": {"$ref": "#/$defs/hash"},
        "human-decision-gate": {"$ref": "#/$defs/hash"},
        "acceptance-group-atomicity": {"$ref": "#/$defs/hash"},
        "ui-dual-skill": {"$ref": "#/$defs/hash"}
      }
    },
    "fiveCwdDiscoveryVerified": {"const": true},
    "testContractLivenessVerified": {"const": true},
    "outputMissingRecoveryVerified": {"const": true},
    "onlineWatchdogVerified": {"const": true},
    "verifierRevalidationVerified": {"const": true},
    "realGitLandingVerified": {"const": true},
    "acceptanceGroupAtomicityVerified": {"const": true},
    "uiDualSkillVerified": {"const": true},
    "humanGateVerified": {"const": true},
    "rootProfileVerified": {"const": true},
    "rootMechanicalControlVerified": {"const": true},
    "mutationControlsKilled": {
      "type": "integer",
      "minimum": 1
    },
    "mutationEvidenceDigest": {"$ref": "#/$defs/hash"},
    "quiescenceViolations": {
      "type": "array",
      "maxItems": 0
    },
    "quiescenceObservationDigest": {"$ref": "#/$defs/hash"},
    "temporaryBootstrapUsed": {"const": false},
    "temporarySchedulerUsed": {"const": false},
    "fallbackExecutorUsed": {"const": false},
    "repoLocalCopyUsed": {"const": false},
    "receiptDigest": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"mode": {"const": "live"}},
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "status": {"const": "production-verified"},
          "productionReady": {"const": true}
        }
      },
      "else": {
        "properties": {
          "status": {"const": "fixture-verified"},
          "productionReady": {"const": false}
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  }
}
