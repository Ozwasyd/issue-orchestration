{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:issue-orchestration:permanent-e2e-receipt:v1",
  "title": "issue-orchestration.permanent-e2e-receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "status",
    "liveRemoteEvidence",
    "packageDigest",
    "sourceCommit",
    "repositories",
    "dependencyStates",
    "laneEvidence",
    "childRollouts",
    "fiveCwdDiscoveryVerified",
    "realGitLandingVerified",
    "testContractLivenessVerified",
    "outputMissingRecoveryVerified",
    "acceptanceGroupAtomicityVerified",
    "uiDualSkillVerified",
    "humanGateVerified",
    "mutationControlsKilled",
    "falsePositiveDagDispatchCount",
    "temporaryBootstrapUsed",
    "temporaryBootstrapRunId",
    "temporaryBootstrapDisposition",
    "resourceLifecycleSha256",
    "quiescenceReceiptDigest",
    "quiescenceViolations",
    "remoteReread",
    "receiptDigest"
  ],
  "properties": {
    "schema": {
      "const": "issue-orchestration.permanent-e2e-receipt.v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "verified"
    },
    "liveRemoteEvidence": {
      "type": "boolean"
    },
    "packageDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "repositories": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "root",
          "head",
          "branch",
          "remoteHead",
          "worktreeCount",
          "localBranchCount",
          "statusDigest"
        ],
        "properties": {
          "repository": {
            "enum": [
              "Ozwasyd/FsusBlog",
              "Ozwasyd/FsusUI"
            ]
          },
          "root": {
            "type": "string",
            "minLength": 1
          },
          "head": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "remoteHead": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "worktreeCount": {
            "const": 1
          },
          "localBranchCount": {
            "const": 1
          },
          "statusDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "dependencyStates": {
      "type": "array",
      "minItems": 22,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "state",
          "evidenceDigest"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "const": "CLOSED"
          },
          "evidenceDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "laneEvidence": {
      "type": "array",
      "minItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "laneFile",
          "status",
          "evidenceFiles",
          "evidenceDigest"
        ],
        "properties": {
          "laneFile": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "verified"
          },
          "evidenceFiles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidenceDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "childRollouts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rolloutId",
          "command",
          "exitCode",
          "stdoutDigest",
          "stderrDigest",
          "durationMs",
          "testSummary"
        ],
        "properties": {
          "rolloutId": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "exitCode": {
            "const": 0
          },
          "stdoutDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stderrDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "testSummary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "fiveCwdDiscoveryVerified": {
      "const": true
    },
    "realGitLandingVerified": {
      "const": true
    },
    "testContractLivenessVerified": {
      "const": true
    },
    "outputMissingRecoveryVerified": {
      "const": true
    },
    "acceptanceGroupAtomicityVerified": {
      "const": true
    },
    "uiDualSkillVerified": {
      "const": true
    },
    "humanGateVerified": {
      "const": true
    },
    "mutationControlsKilled": {
      "const": 19
    },
    "falsePositiveDagDispatchCount": {
      "const": 0
    },
    "temporaryBootstrapUsed": {
      "const": false
    },
    "temporaryBootstrapRunId": {
      "const": "cdfdbdbe-d901-4482-bafe-c4ba92c17779"
    },
    "temporaryBootstrapDisposition": {
      "enum": [
        "audit-only-pending-final-retirement",
        "retired-audit-only"
      ]
    },
    "resourceLifecycleSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "quiescenceReceiptDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "quiescenceViolations": {
      "type": "array",
      "maxItems": 0
    },
    "remoteReread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blogHead",
        "fsusUIHead",
        "dependencySnapshotDigest"
      ],
      "properties": {
        "blogHead": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "fsusUIHead": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "dependencySnapshotDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "receiptDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
