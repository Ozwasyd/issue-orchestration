{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:issue-orchestration:candidate-supersession-mapping:v1",
  "title": "issue-orchestration.candidate-supersession-mapping.v1",
  "type": "object",
  "required": [
    "schema",
    "producerAuthority",
    "policyDigest",
    "lifecycleId",
    "runId",
    "rootAuthorityEpoch",
    "attemptId",
    "repositoryId",
    "leaseId",
    "deliveryEpoch",
    "oldCandidateSha",
    "oldCandidateTree",
    "replacementCandidateSha",
    "replacementCandidateTree",
    "mappingType",
    "uniqueWorkPreserved",
    "replacementAcceptanceReceiptDigest",
    "replacementVerificationReceiptDigest",
    "observedAt",
    "mappingDigest"
  ],
  "properties": {
    "schema": {"const": "issue-orchestration.candidate-supersession-mapping.v1"},
    "producerAuthority": {"const": "machine-candidate-supersession-mapper"},
    "policyDigest": {"$ref": "#/$defs/digest"},
    "lifecycleId": {"$ref": "#/$defs/digest"},
    "runId": {"type": "string", "minLength": 1},
    "rootAuthorityEpoch": {"type": "string", "minLength": 1},
    "attemptId": {"type": "string", "minLength": 1},
    "repositoryId": {"type": "string", "minLength": 1},
    "leaseId": {"type": "string", "minLength": 1},
    "deliveryEpoch": {"type": "string", "minLength": 1},
    "oldCandidateSha": {"$ref": "#/$defs/sha"},
    "oldCandidateTree": {"$ref": "#/$defs/sha"},
    "replacementCandidateSha": {"$ref": "#/$defs/sha"},
    "replacementCandidateTree": {"$ref": "#/$defs/sha"},
    "mappingType": {"const": "commit-ancestry"},
    "uniqueWorkPreserved": {"const": true},
    "replacementAcceptanceReceiptDigest": {"$ref": "#/$defs/digest"},
    "replacementVerificationReceiptDigest": {"$ref": "#/$defs/digest"},
    "observedAt": {"type": "string", "format": "date-time"},
    "mappingDigest": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
  }
}
