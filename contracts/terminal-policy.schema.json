{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:issue-orchestration:terminal-policy:v1",
  "title": "issue-orchestration.terminal-policy.v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "categories",
    "recoveryDomains",
    "recoveryPaths",
    "recoveryTerminalStates",
    "humanDecisionTerminalStates",
    "forbiddenTerminalSources"
  ],
  "properties": {
    "schema": {"const": "issue-orchestration.terminal-policy.v1"},
    "version": {"const": "terminal-policy-v1"},
    "categories": {
      "type": "object",
      "required": ["impossible", "externally_blocked", "not_applicable"],
      "properties": {
        "impossible": {"$ref": "#/$defs/category"},
        "externally_blocked": {"$ref": "#/$defs/category"},
        "not_applicable": {"$ref": "#/$defs/category"}
      },
      "additionalProperties": false
    },
    "recoveryDomains": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "dependency",
          "evidence",
          "humanDecision",
          "remote",
          "repository",
          "runtime"
        ]
      }
    },
    "recoveryPaths": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "advisor",
          "continuation",
          "deterministicHandlers",
          "humanDecision",
          "revalidation",
          "retry"
        ]
      }
    },
    "recoveryTerminalStates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["completed", "exhausted", "inapplicable"]}
    },
    "humanDecisionTerminalStates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["completed", "inapplicable"]}
    },
    "forbiddenTerminalSources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "category": {
      "type": "object",
      "required": ["requiredEvidenceKinds"],
      "properties": {
        "requiredEvidenceKinds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  }
}
