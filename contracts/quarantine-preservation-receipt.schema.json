{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:issue-orchestration:quarantine-preservation-receipt:v1",
  "title": "issue-orchestration.quarantine-preservation-receipt.v1",
  "type": "object",
  "required": [
    "schema",
    "producerAuthority",
    "policyDigest",
    "lifecycleId",
    "runId",
    "rootAuthorityEpoch",
    "attemptId",
    "repositoryId",
    "worktreeResourceId",
    "branchResourceId",
    "worktreePath",
    "branchRef",
    "quarantineRef",
    "quarantinePath",
    "baseSha",
    "candidateSha",
    "deliveryEpoch",
    "leaseId",
    "inventoryDigest",
    "reasonCodes",
    "sourceDigest",
    "metadataDigest",
    "stagedPatchDigest",
    "unstagedPatchDigest",
    "indexManifestDigest",
    "untrackedManifestDigest",
    "preservedAt",
    "receiptDigest"
  ],
  "properties": {
    "schema": {"const": "issue-orchestration.quarantine-preservation-receipt.v1"},
    "producerAuthority": {"const": "machine-git-resource-cleaner"},
    "policyDigest": {"$ref": "#/$defs/digest"},
    "lifecycleId": {"$ref": "#/$defs/digest"},
    "runId": {"$ref": "#/$defs/text"},
    "rootAuthorityEpoch": {"$ref": "#/$defs/text"},
    "attemptId": {"$ref": "#/$defs/text"},
    "repositoryId": {"$ref": "#/$defs/text"},
    "worktreeResourceId": {"$ref": "#/$defs/text"},
    "branchResourceId": {"$ref": "#/$defs/text"},
    "worktreePath": {"$ref": "#/$defs/text"},
    "branchRef": {"type": "string", "pattern": "^refs/heads/"},
    "quarantineRef": {
      "type": "string",
      "pattern": "^refs/issue-orchestration/quarantine/"
    },
    "quarantinePath": {"$ref": "#/$defs/text"},
    "baseSha": {"$ref": "#/$defs/sha"},
    "candidateSha": {"$ref": "#/$defs/sha"},
    "deliveryEpoch": {"$ref": "#/$defs/text"},
    "leaseId": {"$ref": "#/$defs/text"},
    "inventoryDigest": {"$ref": "#/$defs/digest"},
    "reasonCodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "sourceDigest": {"$ref": "#/$defs/digest"},
    "metadataDigest": {"$ref": "#/$defs/digest"},
    "stagedPatchDigest": {"$ref": "#/$defs/digest"},
    "unstagedPatchDigest": {"$ref": "#/$defs/digest"},
    "indexManifestDigest": {"$ref": "#/$defs/digest"},
    "untrackedManifestDigest": {"$ref": "#/$defs/digest"},
    "preservedAt": {"type": "string", "format": "date-time"},
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "text": {"type": "string", "minLength": 1}
  }
}
