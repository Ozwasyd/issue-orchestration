    "startup",
    "package-policy",
    "state-root",
    "repository-remote",
    "resource-inventory",
    "dag",
    "continuation",
    "delivery",
    "quiescence"
  ],
  "authorizationTtlSeconds": 300,
  "maxAttemptsPerAuthorization": 1,
  "uniqueRootControlLeaseRequired": true,
  "freeFormConversationAuthority": false,
  "inSessionUpgradeAllowed": false,
  "mediumChildAsRootAllowed": false,
  "automaticRestartAllowed": false,
