{
  "schema": "issue-orchestration.execution-routing-policy.v3",
  "version": "execution-capability-routing.v3",
  "modelPoolPolicyVersion": "stage-model-pool.v3",
  "runtimeExecutionBindingPolicyVersion": "runtime-execution-binding.v1",
  "routingAuthority": "deterministic-execution-capability-compiler",
  "matrixAuthority": "profile-capability-matrix.json",
  "observationAuthority": "profile-capability-observations.json",
  "telemetryAuthority": "observe-only",
  "forbiddenInputs": [
    "balance",
    "subscription",
    "failureCount",
    "reworkCount",
    "telemetryCost",
    "tokenCount",
    "tokenBudget",
    "humanPreference",
    "requestedProfile",
    "selectedProfile",
    "profileOverride",
    "currentRootProfile",
    "sandbox",
    "requiredSandbox",
    "supportedSandboxes"
  ],
  "workShapes": [
    "atomic-edit",
    "bounded-multifile",
    "iterative-debug",
    "runtime-probe-heavy",
    "context-heavy",
    "high-tool-depth",
    "long-horizon-cross-module",
    "observe-only-adjudication",
    "luna-fresh-narrow-deep"
  ],
  "contextBreadthOrder": ["narrow", "moderate", "broad", "very-broad"],
  "shapeRequirements": {
    "atomic-edit": [1, 1, 1, 1, 0, 1],
    "bounded-multifile": [2, 2, 2, 2, 1, 2],
    "iterative-debug": [3, 3, 3, 3, 2, 3],
    "runtime-probe-heavy": [4, 4, 4, 4, 4, 4],
    "context-heavy": [3, 3, 3, 3, 2, 3],
    "high-tool-depth": [4, 4, 4, 4, 3, 4],
    "long-horizon-cross-module": [4, 4, 4, 4, 4, 4],
    "observe-only-adjudication": [3, 3, 3, 3, 2, 3]
    ,
    "luna-fresh-narrow-deep": [4, 2, 2, 1, 1, 2]
  },
  "selectionPriority": {
    "atomic-edit": ["terra-low", "sol-low", "terra-medium", "sol-medium"],
    "bounded-multifile": ["terra-medium", "sol-medium", "terra-high", "sol-high"],
    "iterative-debug": ["sol-high", "sol-xhigh"],
    "runtime-probe-heavy": ["sol-high", "sol-xhigh"],
    "context-heavy": ["sol-high", "sol-xhigh"],
    "high-tool-depth": ["sol-xhigh"],
    "long-horizon-cross-module": ["sol-high", "sol-xhigh"],
    "observe-only-adjudication": ["terra-high", "luna-max", "sol-high", "sol-xhigh"],
    "luna-fresh-narrow-deep": ["luna-max"]
  },
  "uiImplementationProfiles": ["sol-low", "sol-medium"],
  "solMaxRule": "machine-proven-frontier-exception-only",
  "rerouteFailureClass": "route-classification-changed",
  "lunaAvailabilityFallback": {
    "primary": "luna-max",
    "fallback": "terra-high",
    "allowedReasons": ["runtime-unsupported", "runtime-unavailable"],
    "phase": "pre-dispatch-only"
  }
}
