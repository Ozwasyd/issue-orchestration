{
  "schema": "issue-orchestration.stage-permissions.v2",
  "version": "stage-execution-classes.v2",
  "executionClasses": {
    "root-control": {
      "stateAuthority": "mechanical-control-plane-only",
      "remoteAuthority": "policy-gated-root-only",
      "leaseRequirement": "root-control-lease",
      "mutationContract": "control-plane-and-delivery-gated",
      "requiredPostconditionEvidenceClass": "root-control-mutation-postcondition",
      "mutationPostconditionRequired": true
    },
    "observe-only": {
      "stateAuthority": "none",
      "remoteAuthority": "none",
      "leaseRequirement": "forbidden",
      "mutationContract": "no-protected-mutation",
      "requiredPostconditionEvidenceClass": "observe-only-mutation-postcondition",
      "mutationPostconditionRequired": true
    },
    "leased-writer": {
      "stateAuthority": "none",
      "remoteAuthority": "none",
      "leaseRequirement": "stage-write-lease",
      "mutationContract": "lease-and-slice-allowlist",
      "requiredPostconditionEvidenceClass": "leased-writer-mutation-postcondition",
      "mutationPostconditionRequired": true
    }
  },
  "stages": {
    "root-scheduler:scheduling": {
      "executionClass": "root-control",
      "writeScope": "orchestration-control-only",
      "outputAuthority": "mechanical-control-receipt",
      "freshContext": false
    },
    "root-scheduler:recovery-takeover": {
      "executionClass": "root-control",
      "writeScope": "orchestration-control-only",
      "outputAuthority": "mechanical-recovery-control-receipt",
      "freshContext": true
    },
    "dag-creator-updater:semantic-proposal": {
      "executionClass": "observe-only",
      "writeScope": "none",
      "outputAuthority": "proposal-only",
      "freshContext": true
    },
    "test-owner:test-contract-planning": {
      "executionClass": "observe-only",
      "writeScope": "none",
      "outputAuthority": "planning-proposal-only",
      "freshContext": true
    },
    "test-owner:test-contract": {
      "executionClass": "leased-writer",
      "writeScope": "tests-only",
      "outputAuthority": "test-contract-candidate",
      "freshContext": false
    },
    "test-owner:behavior-verification": {
      "executionClass": "observe-only",
      "writeScope": "none",
      "outputAuthority": "independent-behavior-evidence",
      "freshContext": true
    },
    "code-implementer:implementation": {
      "executionClass": "leased-writer",
      "writeScope": "implementation-only",
      "outputAuthority": "implementation-candidate",
      "freshContext": false
    },
    "code-implementer:landing-conflict-resolution": {
      "executionClass": "leased-writer",
      "writeScope": "implementation-only",
      "outputAuthority": "landing-candidate",
      "freshContext": false
    },
    "ui-ux-implementer:ui-implementation": {
      "executionClass": "leased-writer",
      "writeScope": "implementation-only",
      "outputAuthority": "ui-candidate",
      "freshContext": false
    },
    "ui-ux-implementer:landing-conflict-resolution": {
      "executionClass": "leased-writer",
      "writeScope": "implementation-only",
      "outputAuthority": "landing-candidate",
      "freshContext": false
    },
    "ui-system-adjudicator:adjudication": {
      "executionClass": "observe-only",
      "writeScope": "none",
      "outputAuthority": "adjudication-only",
      "freshContext": true
    },
    "ux-acceptance-verifier:ux-acceptance": {
      "executionClass": "observe-only",
      "writeScope": "none",
      "outputAuthority": "independent-ux-evidence",
      "freshContext": true
    },
    "documentation-writer:documentation": {
      "executionClass": "leased-writer",
      "writeScope": "documentation-only",
      "outputAuthority": "documentation-candidate",
      "freshContext": false
    }
  }
}
