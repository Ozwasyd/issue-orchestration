{
  "schema": "issue-orchestration.runtime-trust-policy.v2",
  "defaultMode": "trusted-owner-repositories",
  "modes": {
    "trusted-owner-repositories": {
      "mode": "trusted-owner-repositories",
      "enabled": true,
      "repositoryAdmission": "caller-supplied-operator-owned-remote-identity",
      "rootPermissionProfile": "danger-full-access",
      "approvalPolicy": "never",
      "childPermissionInheritance": "inherited-parent-profile",
      "machineEnforcedRoleIsolation": false,
      "semanticRoleIsolation": "execution-class-and-receipt",
      "mutationPostconditionRequired": true,
      "permissionGuarantee": "contract-and-postcondition"
    },
    "strict-machine-isolation": {
      "mode": "strict-machine-isolation",
      "enabled": false,
      "repositoryAdmission": "caller-supplied-operator-owned-remote-identity",
      "rootPermissionProfile": "runtime-defined",
      "approvalPolicy": "runtime-defined",
      "childPermissionInheritance": "runtime-enforced-profile",
      "machineEnforcedRoleIsolation": true,
      "semanticRoleIsolation": "execution-class-and-receipt",
      "mutationPostconditionRequired": true,
      "permissionGuarantee": "machine-enforced"
    }
  }
}
