{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://issue-orchestration.local/semantic-graph.schema.json",
  "title": "Issue orchestration semantic graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scopeDigest", "semanticGraphInputDigest", "nodes", "semanticGraphDigest"],
  "properties": {
    "schema": {"const": "issue-orchestration.semantic-graph.v1"},
    "scopeDigest": {"$ref": "#/$defs/digest"},
    "semanticGraphInputDigest": {"$ref": "#/$defs/digest"},
    "semanticGraphDigest": {"$ref": "#/$defs/digest"},
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stringArray": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "node": {
      "type": "object",
      "required": ["id", "owner", "riskClass", "uiClass", "contractDigest", "dependencyKeys", "conflictKeys", "acceptanceGroup"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "riskClass": {"type": "string", "minLength": 1},
        "uiClass": {"type": "string", "minLength": 1},
        "contractDigest": {"$ref": "#/$defs/digest"},
        "dependencyKeys": {"$ref": "#/$defs/stringArray"},
        "conflictKeys": {"$ref": "#/$defs/stringArray"},
        "acceptanceGroup": {"type": ["string", "null"]}
      }
    }
  }
}
